---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getSettings, isPreview } from '../lib/settings.js';
const settings = await getSettings();
---

<SiteLayout settings={settings} title="페이지를 찾을 수 없습니다" route="404.html" preview={isPreview()} noindex={true}>
  <section class="not-found shell">
    <h1>페이지를 찾을 수 없습니다.</h1>
    <p>주소가 변경되었거나 아직 발행되지 않은 글입니다.</p>
    <a class="text-link" href={settings.urlFor('')}>홈으로 돌아가기 →</a>
  </section>
</SiteLayout>
