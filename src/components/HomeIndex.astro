---
import { topics } from '../data/navigation.js';
---

<section class="home-index" aria-labelledby="home-index-title" id="home-index">
  <h2 id="home-index-title">INDEX</h2>
  <nav class="home-topic-grid" aria-label="주제별 글 보기">
    {topics.map(topic => (
      <a class="home-topic-link" href={`#topic/${encodeURIComponent(topic)}`}>
        <span>{topic}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
      </a>
    ))}
  </nav>
</section>
