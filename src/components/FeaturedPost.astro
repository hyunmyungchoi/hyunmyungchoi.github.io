---
import { series, seriesNames } from '../data/navigation.js';
import PostViews from './PostViews.astro';
import { publicIntegrations } from '../lib/integrations.js';
const { post, settings, preview } = Astro.props;
const artwork = post && series.find(item => item.id === post.series);
const href = post ? settings.urlFor(`posts/${post.slug}/`) : '';
const integrations = publicIntegrations(settings, { preview });
---

<section class="home-feature" aria-labelledby="home-title">
  <div class="feature-topline"><p class="feature-heading">대표 글</p><a class="text-link" href="#latest">모든 글 보기 <span aria-hidden="true">↗</span></a></div>
  {post ? <div class="feature-grid">
    <div class="feature-copy">
      <p class="feature-kicker">{post.tags.join(' / ')}</p>
      <h1 id="home-title"><a class="feature-title-link" href={href}>{post.title}</a></h1>
      <p class="feature-summary">{post.summary}</p>
      <div class="feature-meta"><time datetime={post.publishedAt}>{post.publishedAt.replaceAll('-', '.')}</time><PostViews settings={settings} slug={post.slug} integration={integrations.goatcounter} /></div>
      <a class="text-link feature-action" href={href}>글 읽기 <span aria-hidden="true">→</span></a>
    </div>
    <a class="feature-artwork" href={href} tabindex="-1" aria-hidden="true">
      <img src={settings.urlFor(artwork.cover)} alt="" width="1200" height="600" decoding="async" fetchpriority="high" />
      <span>{seriesNames[post.series]}</span>
    </a>
  </div> : <h1 class="home-empty-title" id="home-title">아직 발행된 글이 없습니다.</h1>}
</section>
